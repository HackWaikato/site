---
import { Image } from "astro:assets";

const { name, href, id } = Astro.props;
const src = import(`../../assets/images/gallery/${id}.png`);
---

<a {href}>
  <Image {src} alt="A screenshot of a website" width={220} />
  <div class="label">{name}</div>
</a>

<style>
  a {
    display: block;
    width: min-content;
    position: relative;
    border: 5px solid white;
    color: black;
    border-radius: 3px;
  }

  @media (max-width: 500px) {
    img {
      width: 40vw;
    }
  }

  .label {
    width: 100%;
    text-align: center;
    position: absolute;
    bottom: 0;
    background-color: white;
    padding: 8px;
    box-sizing: border-box;
  }
</style>
