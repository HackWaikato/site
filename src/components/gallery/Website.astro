---
import { Image } from "astro:assets";

const { name, href, id } = Astro.props;
const src = import(`../../assets/images/gallery/websites/${id}.png`);
---

<a {href}>
  <Image {src} alt="A screenshot of a website" width={220} loading="lazy" />
  <div class="label">{name}</div>
</a>

<style>
  a {
    max-width: 45%;
    position: relative;
    color: black;
    border-radius: 4px;
    overflow: clip;
  }

  img {
    max-width: auto;
  }


  .label {
    width: 100%;
    text-align: center;
    position: absolute;
    bottom: 0;
    background-color: #FFFD;
    padding: 8px;
    box-sizing: border-box;
  }

  @media (max-width: 80rem) {
    img {
      width: 100%;
      height: auto;
    }
  }
</style>
