---
import Image from "astro/components/Image.astro";
import boba from "../assets/images/Bubble_Tea.png";
import background from "../assets/images/tile.png";
import Close from "../assets/icons/close.svg";
import Signup from "./Signup.astro";
import { getImage } from "astro:assets";

let bgSrc = (await getImage({ src: background })).src;
---

<Image id="boba" src={boba} alt="A cup of bubble tea" loading="eager" />

<div id="boba-popup">
  <div
    style={`background: linear-gradient(transparent 70%, #0002), url(${bgSrc})`}
  >
    <Close id="boba-close" />
    <h2>Websites & Boba</h2>
    <p>
      For our first session on Saturday 12th, we're going to be running a
      'Websites & Boba' workshop where you create your first website (or
      fiftieth) with HTML and CSS and then next session everyone who submitted a
      website will get free bubble tea! This will be a fun, fast-paced
      introduction to web development, where by the end of the session everybody
      will have their own website deployed on the internet for people to see.
    </p>
    <Signup />
  </div>
</div>

<style>
  #boba {
    position: fixed;
    height: min(50vw, 40vh);
    width: auto;
    right: 10%;
    bottom: -5%;

    cursor: pointer;

    animation: 3s ease-in-out infinite alternate slide-in;
    transform-origin: 50% 75%;
  }

  @keyframes slide-in {
    from {
      rotate: -5deg;
    }

    to {
      rotate: 5deg;
    }
  }

  #boba-popup {
    width: 100vw;
    height: 100vh;
    display: none;
    background-color: #00000020;
    position: fixed;
    top: 0;
    bottom: 0;
    backdrop-filter: blur(5px);

    place-items: center;
  }

  #boba-popup > div {
    max-width: 40%;
    min-width: 18em;
    padding: 1rem;
    position: relative;
    z-index: 1;
    border-radius: 15px;
  }

  .visible {
    display: grid !important;
  }

  h2 {
    margin-top: 0.5rem;
  }

  #boba-close {
    height: 2.5rem;
    width: 2.5rem;
    position: absolute;
    right: 1em;
    cursor: pointer;
  }
</style>

<script>
  const popup = document.getElementById("boba-popup");
  [
    popup,
    document.getElementById("boba"),
    document.getElementById("boba-close"),
  ].forEach((element) => {
    element!.addEventListener("click", (e) => {
      if (e.target !== element) return;
      popup!.classList.toggle("visible");
    });
  });
</script>
