---
import Logo from "../components/Logo.astro";
import Signup from "../components/Signup.astro";
import Layout from "../layouts/Layout.astro";
import Instagram from "../assets/icons/instagram.svg";
import Email from "../assets/icons/email.svg";
import Slack from "../assets/icons/slack.svg";
---

<Layout>
  <Logo />
  <div class="yap">
    <Signup />
    <p>
      We're running a weekly meetup for teen makers, coders, and artists to
      build cool stuff, learn new skills, and make new friends.<br />
      Saturdays 1:30-3:30 @ Hamilton Central Library.
    </p>
    <a href="/gallery">Check out what we're building →</a>
    <div class="links">
      <a
        href="https://instagram.com/hackwaikato"
        aria-label="Instagram page"
        target="_blank"><Instagram /></a
      >

      <a
        href="https://hackclub.enterprise.slack.com/archives/C0C12D1LP8R"
        aria-label="Come chat on Slack"
        target="_blank"><Slack /></a
      >
      <a
        href="mailto:club@hackwaikato.org"
        aria-label="Email us!"
        target="_blank"><Email /></a
      >
    </div>
  </div>
</Layout>

<style>
  p {
    background-color: white;
    box-shadow: 3px 3px rgba(0, 0, 0, 0.293);
    padding: 0.5rem;

    text-align: justify;
    text-align-last: center;

    box-sizing: border-box;
  }

  a {
    color: #ec3750;
    font-weight: bold;
    text-align: center;
    text-decoration-thickness: 2px;
    text-decoration-skip-ink: none;
  }

  .yap {
    max-width: 25em;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
  }

  .yap > :global(*) {
    width: 100%;
  }

  .links {
    display: flex;
    justify-content: center;
  }

  .links a {
    display: block;
    width: fit-content;
  }

  .links a:hover {
    background: radial-gradient(circle at top left, #ff8c37, #ec3750);
    border-radius: 4px;
  }

  .links a:hover * {
    fill: white;
  }
</style>
