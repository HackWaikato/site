---

<Base title="Gallery" description="Come see what our members are building">
  <slot name="header">
    <link rel="stylesheet" href="https://unpkg.com/7.css/dist/gui/window.css" />
  </slot>
  <svg width="0" height="0" class="block">
    <filter id="grainy" x="0" y="0" width="100%" height="100%">
      <feTurbulence type="fractalNoise" baseFrequency=".3" numOctaves="2"
      ></feTurbulence>
      <feColorMatrix type="saturate" values="0"></feColorMatrix>
      <feBlend in="SourceGraphic" mode="multiply"></feBlend>
    </filter>
  </svg>
  <a class="back" href="/">← Back to home</a>
  <header id="intro">
    <div>
      <h1>Project Gallery</h1>
      <p>
        Hack Clubbers are building awesome projects at every meeting. We're
        making electronics, websites, tools, art and more! Each of the projects
        on this page is a real project built by a club member.
      </p>
    </div>
    <div style="display: flex; gap: 1rem;">
      <!-- Turn the JavaScript object into Astro components -->
      {Object.entries(projects).map(([k, v]) => <Website {...v} id={k} />)}
    </div>
  </header>
  <section id="hardware">
    <h2>Hardware and 3D models</h2>
    <p>
      Learn how to build hardware projects using real industry tools - circuit
      boards, CAD, 3D Printing, and more. Through Hack Club, you can also get
      funding to cover the cost of materials - there's no reason your crazy idea
      has to stay in your head.
    </p>
    <a id="hackpad" href="https://hackpad.hackclub.com/" target="_blank"
      >Start your first project!</a
    >
    <canvas id="c"></canvas>
    <Model
      id="badapple"
      style="right: 5%; top: 12%; height: 88%; aspect-ratio: 1;"
    />
    <Model id="quote" style="right: 30%; height: 100%; aspect-ratio: 1;" />
    <Model id="star" style="right: 1%; height: 40%; aspect-ratio: 1;" />
    <div class="box" style="left: 52%; bottom: 1em;">
      <div style="display: block">quote</div>
      <a href="https://youtube.com/shorts/p4QXuOgkP3A">demo</a>&nbsp;&nbsp;
      <a href="https://codeberg.org/logabe/quote">files</a>
    </div>
    <div class="box" style="left: 75%; bottom: 30%;">
      3D-printed cookie cutters
    </div>
  </section>
  <section id="websites">
    <div class="websites">
      <div id="yap1">
        <Image src={Websites} alt="Websites" />
        <p>
          In the age of social media, Hack Clubbers are reclaiming their space
          on the internet! Most classes only teach you about HTML & CSS, but we
          show you how to put your website online so that anyone can see it.
          Check out some of these sites!
        </p>
      </div>
      <div class="gallery">
        <!-- Turn the JavaScript object into Astro components -->
        {Object.entries(sites).map(([k, v]) => <Website {...v} id={k} />)}
      </div>
    </div>
    <hr />
    <div id="yap">
      <Image src={Boba} alt="Boba Drops" />
      <p>
        At our first meeting, we ran a website-making workshop with a sweet
        twist! 14 students used HTML and CSS to make their own unique websites
        and put them online in just 2 hours. There were some incredible sites
        made despite half the attendees having never coded before. Afterwards we
        all celebrated our success with free bubble tea :D
      </p>
    </div>
    <div class="window">
      <div class="title-bar">
        <div class="title-bar-text">Websites</div>
        <div class="title-bar-controls">
          <button aria-label="Minimize"></button>
          <button aria-label="Maximize"></button>
          <button aria-label="Close"></button>
        </div>
      </div>
      <div class="window-body">
        <!-- Turn the JavaScript object into Astro components -->
        {Object.entries(bobasites).map(([k, v]) => <Website {...v} id={k} />)}
      </div>
    </div>
  </section>
  <section id="cta">
    Want to build your first project (or fiftieth)? Sign up to get reminded when
    we start back up!
    <Signup />
  </section>
  <a class="back" href="/">← Back to home</a>
</Base>

<style>
  :global(body) {
    overflow-x: clip;

    background-size: 50px 50px;
    background-image:
      linear-gradient(to right, #dbe4ee 2px, #0000 1px),
      linear-gradient(#dbe4ee 2px, #0000 1px);
  }

  * {
    box-sizing: border-box;
  }

  a {
    color: #ec3750;
    font-weight: 600;
  }

  .back {
    padding: 1rem;
    display: block;
  }

  header,
  section {
    padding: 1em;
  }

  /* Hardware */
  #hardware::before {
    content: "";
    filter: url(#grainy);
    mix-blend-mode: multiply;
    background: radial-gradient(#000000b1, #0000);
    opacity: 0.4;
    position: absolute;
    inset: 0;
  }

  #hardware {
    color: #dbe4ee;

    min-height: 30vh;
    position: relative;

    /* Blueprint background */
    background-color: #0d2d55;
    background-size: 50px 50px;
    background-image:
      linear-gradient(#ffffff0d 1px, #0000 1px),
      linear-gradient(90deg, #ffffff0d 1px, #0000 1px);

    :not(div, canvas) {
      position: relative;
      z-index: 1;
    }
  }

  #hackpad {
    display: inline-block;
    margin-top: 1rem;
    padding: 0.5rem;
    outline: 2px dashed #ec3750;
    background-color: #ec374f20;
  }

  #hackpad:hover {
    outline: 4px dashed #ec3750;
    background-color: #ec374f40;
  }

  #c {
    width: 100% !important;
    height: 100% !important;
    top: 0;
    left: 0;
    position: absolute;
    z-index: 0;
  }

  .box {
    position: absolute;
    color: black;
  }

  /* Websites */

  #websites {
    --pink1: #f6dade;
    min-height: 60vh;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    gap: 1em;
    align-items: center;

    background-size: 90px 90px;
    background-image:
      linear-gradient(to bottom right, var(--pink1) 32px, transparent 32px),
      linear-gradient(to bottom left, var(--pink1) 32px, transparent 32px),
      linear-gradient(to top right, var(--pink1) 32px, transparent 32px),
      linear-gradient(to top left, var(--pink1) 32px, transparent 32px);
    background-color: #f2c8cd;

    > * {
      width: 80%;
    }

    > img {
      width: auto;
    }

    p::before {
      content: "<p> ";
    }

    p::after {
      content: " </p>";
    }

    p::before,
    p::after {
      color: grey;
      display: inline-block;
    }

    hr {
      border-top: 2px solid black;
      width: 100%;
      border-style: ridge;
    }
  }

  #websites p,
  .box {
    background-color: white;
    box-shadow: 3px 3px rgba(0, 0, 0, 0.293);
    padding: 0.5rem;

    text-align: justify;

    box-sizing: border-box;
  }

  .websites {
    display: flex;
    flex-direction: row;
    gap: 2em;
  }

  #yap1 {
    flex: 1;
  }

  .gallery {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1em;
  }

  #yap {
    img {
      max-width: 100%;
      height: auto;
    }
  }

  #cta {
    max-width: fit-content;
    margin: auto;
  }

  .window-body {
    display: flex;
    flex-direction: row;
    overflow: scroll;
    gap: 0.5em;
    padding: 0.5rem;
  }

  @media (max-width: 80rem) {
    #websites > * {
      width: 90% !important;
    }
    .window-body {
      flex-wrap: wrap;
      max-height: 75vh;
      justify-content: center;
    }
  }

  @media (min-width: 80rem) {
    #intro {
      display: flex;
      gap: 2rem;
    }
  }

  @media (min-width: 100rem) {
    #yap {
      display: grid;
      grid-template-columns: 2fr 3fr;
      gap: 2em;
      align-items: center;

      p {
        margin: 0;
      }
    }
  }

  @media (min-width: 1000px) {
    #hardware p {
      max-width: 50%;
    }
  }
</style>

<script>
  import {
    Scene,
    PerspectiveCamera,
    WebGLRenderer,
    MeshPhongMaterial,
    Mesh,
    DirectionalLight,
    AmbientLight,
  } from "three";
  import { OrbitControls } from "three/addons/controls/OrbitControls.js";
  import { GLTFLoader } from "three/addons/loaders/GLTFLoader.js";
  import badapple from '../assets/models/badapple.glb?url'
  import quote from '../assets/models/quote.glb?url'
  import star from '../assets/models/star.glb?url'

  const models = [
    {
      path: badapple,
      id: "badapple",
      scale: 0.15,
      color: "red",
      rotateX: true,
    },
    {
      path: quote,
      id: "quote",
      scale: 20,
    },
    {
      path: star,
      id: "star",
      scale: 13,
      rotateX: true,
    },
  ];

  const canvas = document.getElementById("c") as HTMLCanvasElement;

  models.forEach((element) => {
    element.elem = document.getElementById(element.id)!;
    const scene = new Scene();

    const camera = new PerspectiveCamera(
      45,
      window.innerWidth / canvas!.clientHeight,
      0.1,
      5,
    );
    camera.position.z = 2.2;
    scene.add(camera);

    const ambientLight = new AmbientLight(0xfcf4d5, 0.5);
    scene.add(ambientLight);

    const light = new DirectionalLight(0xffffff, 1);
    light.position.set(-1, 2, 4);
    camera.add(light);

    const loader = new GLTFLoader();
    loader.load(
      element.path,
      function (gltf) {
        const model = gltf.scene;

        if (element.color) {
          const material = new MeshPhongMaterial({
            color: element.color,
            flatShading: true,
          });
          model.traverse((obj) => {
            if (obj instanceof Mesh) obj.material = material;
          });
        }

        if (element.rotateX === true) model.rotateX(Math.PI / 2);
        model.scale.multiplyScalar(element.scale);
        scene.add(model);
      },
      undefined,
      (error) => console.error(error),
    );

    const controls = new OrbitControls(camera, element.elem);
    controls.autoRotate = true;
    controls.autoRotateSpeed = 1 + Math.random();
    controls.enablePan = false;
    controls.enableZoom = false;
    controls.cursorStyle = "grab";

    element.scene = scene;
    element.camera = camera;
    element.controls = controls;
    element.elem = document.getElementById(element.id)!;
  });

  const renderer = new WebGLRenderer({
    alpha: true,
    canvas,
    powerPreference: "low-power",
    antialias: true,
  });
  renderer.setSize(window.innerWidth, canvas!.clientHeight);
  renderer.setAnimationLoop(animate);

  function animate() {
    renderer.setScissorTest(false);
    // renderer.clear(true, true);
    renderer.setScissorTest(true);
    if (window.innerWidth < 1000) return;

    models.forEach((model) => {
      const rect = model.elem.getBoundingClientRect();
      const crect = canvas.getBoundingClientRect();
      const { left, bottom, width, height } = rect;
      const positiveYUpBottom = crect.bottom - bottom;

      model.camera.aspect = width / height;
      model.camera.updateProjectionMatrix();
      model.controls.update();
      renderer.setScissor(left, positiveYUpBottom, width, height);
      renderer.setViewport(left, positiveYUpBottom, width, height);
      renderer.render(model.scene, model.camera);
    });
  }

  window.addEventListener(
    "resize",
    () => {
      renderer.setSize(window.innerWidth, canvas!.clientHeight);
    },
    { passive: true },
  );
</script>
