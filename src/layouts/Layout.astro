---
import { Font } from "astro:assets";
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>Hamilton City Hack Club</title>
		<Font cssVariable="--font-phantom-sans" />
	</head>
	<body>
		<main>
			<slot />
		</main>
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
		font-family: var(--font-phantom-sans);
		font-size: 16px;
	}

	body {
		display: grid;
		place-items: center;

		background-color: #F5F5F5;
		background-size: 50px 50px;
		background-image:
			linear-gradient(to right, #D2D2D2 2px, transparent 1px),
			linear-gradient(to bottom, #D2D2D2 2px, transparent 1px);
	}

	main {
		min-width: min(35em, 90vw);
		width: 50%;

		display: flex;
		flex-direction: column;
		align-items: center;

		gap: 1.5em;
	}
</style>
